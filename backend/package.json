{
  "name": "health-app-backend",
  "version": "1.0.0",
  "description": "Backend API for Health & Wellness Application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "ts-node src/database/migrations/run.ts",
    "seed": "ts-node src/database/seeds/run.ts",
    "docker:build": "docker build -t health-app-backend .",
    "docker:run": "docker run -p 3000:3000 health-app-backend"
  },
  "keywords": [
    "health",
    "wellness",
    "fitness",
    "nutrition",
    "telehealth",
    "api"
  ],
  "author": "Health App Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "typeorm": "^0.3.17",
    "redis": "^4.6.10",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "uuid": "^9.0.1",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "express-rate-limit": "^7.1.5",
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1507.0",
    "stripe": "^14.9.0",
    "twilio": "^4.19.0",
    "@sendgrid/mail": "^7.7.0",
    "firebase-admin": "^11.11.1",
    "axios": "^1.6.2",
    "node-cron": "^3.0.3",
    "express-winston": "^4.2.0",
    "express-async-errors": "^3.1.1",
    "graphql": "^16.8.1",
    "apollo-server-express": "^3.13.0",
    "socket.io": "^4.7.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-apple": "^2.0.2",
    "express-session": "^1.17.3",
    "cookie-parser": "^1.4.6",
    "express-validator": "^7.0.1",
    "joi": "^17.11.0",
    "moment": "^2.29.4",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcrypt": "^5.0.2",
    "@types/uuid": "^9.0.7",
    "@types/multer": "^1.4.11",
    "@types/morgan": "^1.9.9",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/yamljs": "^0.2.34",
    "@types/node-cron": "^3.0.11",
    "@types/express-winston": "^4.0.0",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^3.0.13",
    "@types/express-session": "^1.17.10",
    "@types/cookie-parser": "^1.4.6",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2",
    "nock": "^13.4.0",
    "factory-girl": "^5.0.4",
    "@types/factory-girl": "^5.0.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}